{
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/app", "destination": "/api/index.py" },
    { "source": "/", "destination": "/api/index.py" }
  ],
  "crons": [
    { "path": "/api/cron/scan", "schedule": "15 3 * * *" }
  ]
}
